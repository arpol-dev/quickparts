<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="cron_attendance_create_allocations" model="ir.cron">
            <field name="name">Création des allocations à partir des présences</field>
            <field name="model_id" ref="model_attendance_analysis"/>
            <field name="state">code</field>
            <field name="code">model._cron_create_allocations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=23, minute=30, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
