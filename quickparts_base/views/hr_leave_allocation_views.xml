<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_allocation_view_form_timbrage" model="ir.ui.view">
        <field name="name">hr.leave.allocation.form.timbrage</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="attendance_analysis_id" invisible="1"/>
                <button name="action_view_attendance_analysis" type="object"
                        class="oe_stat_button" icon="fa-clock-o"
                        attrs="{'invisible': [('attendance_analysis_id', '=', False)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Analyse de présence</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
